#!/usr/bin/env bash
# pi-agent — dispatcher for driving a pi (pi-coding-agent) CLI session via tmux.
# See ../SKILL.md for the contract.

set -euo pipefail

SID="codex-pi"
if [ "${1:-}" = "--session" ]; then
  SID="$2"
  shift 2
fi

VERB="${1:-}"
shift || true

strip_ansi() {
  perl -pe 's/\e\[[0-9;?]*[A-Za-z]//g; s/\e\][^\a]*\a//g'
}

# BUSY_RE — the "agent is actively working" indicator for this TUI. The single
# per-agent knob: used both to confirm a submit landed (type_and_submit) and to
# detect idle (wait). pi shows a braille spinner + "Working..." (e.g. "⠼ Working...").
# Status words and the generic "to interrupt/cancel" text keep it portable.
BUSY_RE='[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]|Working\.\.\.|Thinking\.\.\.|Running\.\.\.|\bto +(interrupt|cancel)\b'

# Type a message and submit it. Some TUIs swallow the first Enter after a paste
# (treating it as a newline inside the draft) or take time to visually clear
# the input box after submission, so we:
#   1) type the text literally,
#   2) wait for a 30-char canary to appear in the bottom ~15 lines (input-box region),
#   3) send Enter, wait 1.2s, then accept submission if either:
#        - the working indicator ($BUSY_RE) is visible (positive), or
#        - the canary is gone from the bottom 15 lines (negative).
#      Retry up to 3 times.
type_and_submit() {
  local msg="$1"
  # Mark "task sent at this instant" for the hook-based `wait` (sentinel mode).
  # Written BEFORE typing so its mtime is guaranteed earlier than the agent_end
  # completion that follows — makes the .done-newer-than-.sent test race-free.
  touch "/tmp/$SID.sent" 2>/dev/null || true
  tmux send-keys -t "$SID" -l "$msg"
  local probe="${msg:0:30}"

  local confirmed=""
  for _ in $(seq 1 20); do   # 20 * 0.25s = 5s to appear in draft
    if tmux capture-pane -t "$SID" -p -S -15 2>/dev/null | strip_ansi | grep -qF "$probe"; then
      confirmed=1
      break
    fi
    sleep 0.25
  done
  if [ -z "$confirmed" ]; then
    echo "warn: typed text never landed in input box within 5s" >&2
  fi

  sleep 0.5   # let the input widget settle
  local attempt snap
  for attempt in 1 2 3; do
    tmux send-keys -t "$SID" Enter
    sleep 1.2
    snap=$(tmux capture-pane -t "$SID" -p -S -15 2>/dev/null | strip_ansi)
    # Positive: working indicator visible (pi shows "⠼ Working...")
    if printf '%s' "$snap" | grep -qE "$BUSY_RE"; then
      return 0
    fi
    # Negative: canary gone from input-box region
    if ! printf '%s' "$snap" | grep -qF "$probe"; then
      return 0
    fi
  done
  echo "warn: Enter sent 3x but no submission signal detected" >&2
  return 0
}

need_session() {
  tmux has-session -t "$SID" 2>/dev/null || {
    echo "error: no session '$SID'" >&2
    exit 1
  }
}

case "$VERB" in
  start)
    if tmux has-session -t "$SID" 2>/dev/null; then
      echo "error: session '$SID' already running; run 'stop' first" >&2
      exit 1
    fi
    # Clear any stale completion markers from a previous session of this name.
    rm -f "/tmp/$SID.done" "/tmp/$SID.sent" 2>/dev/null || true
    # pi needs the model-provider API keys (e.g. ZAI_API_KEY, ANTHROPIC_API_KEY)
    # in its environment; tmux execs the command with no shell init. Preferred:
    # a dedicated env file (~/.config/cc-agents/env, created by install.sh) that
    # holds ONLY the keys the worker needs — portable across shells and avoids
    # leaking the whole interactive-shell environment to the worker. Fallback:
    # launch via the user's login shell so rc-exported keys still reach pi.
    # CC_DONE_SENTINEL: the cc-notify extension writes this file on agent_end,
    # which the `wait` verb uses for exact (hook-based) completion detection.
    # Passed as an env prefix inside the command (not tmux's -e flag, which
    # requires tmux >= 3.2) so this works on older tmux too.
    # --approve: trust project-local files so a non-interactive start doesn't hang
    # on pi's "Trust project folder?" prompt.
    ENV_FILE="${CC_AGENTS_ENV:-$HOME/.config/cc-agents/env}"
    if [ -f "$ENV_FILE" ]; then
      tmux new-session -d -s "$SID" -x 220 -y 50 \
        "set -a; . '$ENV_FILE'; set +a; CC_DONE_SENTINEL='/tmp/$SID.done' exec pi --approve"
    else
      tmux new-session -d -s "$SID" -x 220 -y 50 \
        "CC_DONE_SENTINEL='/tmp/$SID.done' exec ${SHELL:-/bin/bash} -ic 'exec pi --approve'"
    fi

    # pi shows a header line "escape interrupt · ctrl+c/ctrl+d clear/exit · / commands · ! bash · ctrl+o more"
    # once the TUI has initialized.
    READY_RE='clear/exit.*commands|escape +interrupt.*clear/exit'
    READY=""
    for _ in $(seq 1 40); do   # 40 * 0.5s = 20s budget
      if tmux capture-pane -t "$SID" -p -S -100 2>/dev/null | strip_ansi | grep -qE "$READY_RE"; then
        READY=1
        break
      fi
      sleep 0.5
    done
    if [ -z "$READY" ]; then
      echo "error: pi did not become ready within 20s; run 'capture' to inspect or 'stop' to tear down" >&2
      exit 1
    fi

    if [ "$#" -gt 0 ]; then
      type_and_submit "$*"
    fi
    echo "started session=$SID"
    ;;

  send)
    need_session
    MSG="$*"
    if [ -z "$MSG" ]; then
      echo "usage: send <message>" >&2
      exit 1
    fi
    type_and_submit "$MSG"
    echo "sent session=$SID chars=${#MSG}"
    ;;

  keys)
    need_session
    KEY="${1:-}"
    if [ -z "$KEY" ]; then
      echo "usage: keys <name>" >&2
      exit 1
    fi
    tmux send-keys -t "$SID" "$KEY"
    echo "sent key=$KEY"
    ;;

  capture)
    need_session
    LINES="${1:-500}"
    tmux capture-pane -t "$SID" -p -S -1000 | strip_ansi | tail -n "$LINES"
    ;;

  wait)
    # Block until pi goes idle, then exit. Meant to be run via a backgrounded
    # Bash (run_in_background: true) so the harness notifies the orchestrator on exit —
    # auto-detection of "pi finished" without polling on a timer.
    #
    # Two detection modes, auto-selected:
    #
    #   SENTINEL (preferred, exact) — used when the cc-notify extension is
    #     installed and a task was sent through this dispatcher. The extension
    #     writes /tmp/<sid>.done on pi's agent_end event; we exit as soon as that
    #     file is newer than /tmp/<sid>.sent (written before the task was typed).
    #     This is race-free: if pi finished before `wait` even started, .done is
    #     already newer and we exit immediately. No screen-scraping. We still
    #     watch the pane for a stalled permission prompt (agent_end won't fire
    #     while pi waits on one).
    #
    #   SPINNER (fallback) — when the hook isn't available. Two phases: arm on the
    #     working indicator appearing, then exit once it's been gone for STABLE secs.
    #
    # Final stdout line is the state the orchestrator reads on wake-up:
    #   idle    — task complete (hook fired, or spinner gone and stable)
    #   prompt  — idle but a y/n-style permission prompt is on screen
    #   timeout — still busy after the overall cap
    #   gone    — session was killed while waiting
    need_session
    POLL=2
    STABLE="${1:-6}"        # secs the spinner must stay gone before declaring idle
    TIMEOUT="${2:-1800}"    # overall cap (30 min default)
    ARM="${ARM_TIMEOUT:-25}"

    # Working indicator comes from the shared BUSY_RE knob (top of file).
    spinner_re="$BUSY_RE"
    prompt_re='\[y/n\]|\(y/[nN]\)|\by/n\b|\bAllow\b|\bapprove\b|Do you want|Yes/No|❯'

    snap_pane() {
      tmux has-session -t "$SID" 2>/dev/null || return 1
      tmux capture-pane -t "$SID" -p -S -30 2>/dev/null | strip_ansi 2>/dev/null || true
    }

    # --- hook-based sentinel detection -------------------------------------
    HOOK_FILE="$HOME/.pi/agent/extensions/cc-notify.ts"
    DONE_FILE="/tmp/$SID.done"
    SENT_FILE="/tmp/$SID.sent"
    mtime() { stat -f %Fm "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }
    done_fresh() {
      [ -f "$DONE_FILE" ] && [ -f "$SENT_FILE" ] || return 1
      awk -v d="$(mtime "$DONE_FILE")" -v s="$(mtime "$SENT_FILE")" 'BEGIN{exit !(d>s)}'
    }

    start_ts=$SECONDS

    if [ -f "$HOOK_FILE" ] && [ -f "$SENT_FILE" ]; then
      # SENTINEL MODE — exact completion via the agent_end hook.
      prompt_hits=0
      while [ $((SECONDS - start_ts)) -lt "$TIMEOUT" ]; do
        tmux has-session -t "$SID" 2>/dev/null || { echo "gone session=$SID"; exit 0; }
        if done_fresh; then
          echo "idle session=$SID note=task-appears-complete-via-agent_end-hook"
          exit 0
        fi
        # agent_end won't fire while pi blocks on a permission prompt; detect that
        # by scraping, debounced over 3 polls to avoid transient false positives.
        snap=$(snap_pane) || { echo "gone session=$SID"; exit 0; }
        if printf '%s' "$snap" | grep -qE "$spinner_re"; then
          prompt_hits=0
        elif printf '%s' "$snap" | grep -qE "$prompt_re"; then
          prompt_hits=$((prompt_hits + 1))
          if [ "$prompt_hits" -ge 3 ]; then
            echo "prompt session=$SID note=idle-with-possible-permission-prompt"
            exit 0
          fi
        else
          prompt_hits=0
        fi
        sleep "$POLL"
      done
      echo "timeout session=$SID note=no-agent_end-within-${TIMEOUT}s"
      exit 0
    fi
    # otherwise fall through to SPINNER MODE below

    # Phase 1: wait for the working indicator to appear. Poll fast (0.5s) so a
    # brief spinner from a fast model isn't missed. If it never appears, the agent
    # either finished before we armed or never started — the orchestrator captures to tell which.
    armed=""
    while [ $((SECONDS - start_ts)) -lt "$ARM" ]; do
      snap=$(snap_pane) || { echo "gone session=$SID"; exit 0; }
      if printf '%s' "$snap" | grep -qE "$spinner_re"; then armed=1; break; fi
      sleep 0.5
    done
    if [ -z "$armed" ]; then
      echo "idle session=$SID note=no-activity-within-${ARM}s-finished-fast-or-not-started"
      exit 0
    fi

    # Phase 2: wait until the indicator has been gone continuously for STABLE secs.
    idle_since=""
    while [ $((SECONDS - start_ts)) -lt "$TIMEOUT" ]; do
      snap=$(snap_pane) || { echo "gone session=$SID"; exit 0; }
      if printf '%s' "$snap" | grep -qE "$spinner_re"; then
        idle_since=""
      else
        [ -z "$idle_since" ] && idle_since=$SECONDS
        if [ $((SECONDS - idle_since)) -ge "$STABLE" ]; then
          if printf '%s' "$snap" | grep -qE "$prompt_re"; then
            echo "prompt session=$SID note=idle-with-possible-permission-prompt"
          else
            echo "idle session=$SID note=task-appears-complete"
          fi
          exit 0
        fi
      fi
      sleep "$POLL"
    done
    echo "timeout session=$SID note=still-busy-after-${TIMEOUT}s"
    exit 0
    ;;

  stop)
    if tmux has-session -t "$SID" 2>/dev/null; then
      tmux kill-session -t "$SID" 2>/dev/null || true
    fi
    echo "stopped session=$SID"
    ;;

  list)
    tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^codex-pi' || echo "no active sessions"
    ;;

  *)
    echo "usage: pi-agent [--session <name>] <start|send|keys|capture|wait|stop|list> [args]" >&2
    exit 2
    ;;
esac
